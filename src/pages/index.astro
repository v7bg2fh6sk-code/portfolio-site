---
import '../styles/global.css';

// Данные отдельно от разметки: правишь цену здесь — меняется на сайте.
const services = [
	{
		title: 'Telegram-бот',
		price: 'от 15 000 ₽',
		description: 'Меню, приём заявок, уведомления, рассылки. Подключение к вашим таблицам или CRM.',
		features: ['Сценарий и логика бота', 'Хостинг и запуск на сервере', '2 недели поддержки после сдачи'],
	},
	{
		title: 'Бот с оплатой',
		price: 'от 35 000 ₽',
		description: 'Подписки, приём платежей, база пользователей, админ-панель со статистикой.',
		features: ['Платежи и подписки', 'База данных и админка', 'Реферальная система'],
		featured: true,
	},
	{
		title: 'Сайт-лендинг',
		price: 'от 20 000 ₽',
		description: 'Одностраничный сайт под задачу: услуги, товар, запись. Адаптив под телефон.',
		features: ['Вёрстка и адаптив', 'Форма заявок', 'Публикация и домен'],
	},
];
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Леонид — разработчик. Telegram-боты с оплатой, сайты, интеграции." />
		<title>Леонид — разработчик Telegram-ботов</title>
	</head>

	<body class="min-h-screen overflow-x-hidden bg-neutral-950 text-neutral-100 antialiased">

		<!--
			ПЕРВЫЙ ЭКРАН
			relative — нужно, чтобы светящиеся пятна внутри позиционировались
			относительно этого блока, а не всей страницы.
		-->
		<header class="relative overflow-hidden">

			<!-- Два размытых пятна за текстом. Классы .glow и анимация — в global.css -->
			<div class="glow -left-32 -top-32 h-96 w-96 bg-indigo-500"></div>
			<div class="glow -right-40 top-20 h-96 w-96 bg-sky-500" style="animation-delay: 3s"></div>

			<!-- relative + z-10 поднимают текст над пятнами -->
			<div class="relative z-10 mx-auto max-w-3xl px-6 py-28 sm:py-36">
				<p class="rise mb-4 text-sm uppercase tracking-widest text-neutral-500">
					Разработка на заказ
				</p>

				<h1 class="rise rise-delay-1 text-4xl font-semibold leading-tight sm:text-6xl">
					Telegram-боты,<br />
					<!--
						Градиентный текст. Как это устроено:
						bg-gradient-to-r — заливаем блок градиентом слева направо
						bg-clip-text + text-transparent — показываем заливку только внутри букв
					-->
					<span class="bg-gradient-to-r from-indigo-400 via-sky-400 to-emerald-400 bg-clip-text text-transparent">
						которые приносят деньги
					</span>
				</h1>

				<p class="rise rise-delay-2 mt-6 max-w-xl text-lg leading-relaxed text-neutral-400">
					Меня зовут Леонид. Делаю ботов с приёмом оплаты, базой пользователей
					и админкой — от идеи до работающего сервера. Пишу код сам, серверы
					настраиваю сам.
				</p>

				<div class="rise rise-delay-3 mt-10 flex flex-wrap gap-3">
					<!--
						hover:-translate-y-0.5 — кнопка чуть приподнимается под курсором
						hover:shadow-lg — и получает тень. Мелочь, а сайт сразу «живой».
					-->
					<a
						href="https://t.me/yriveee"
						class="inline-flex items-center rounded-lg bg-neutral-100 px-5 py-3 font-medium text-neutral-950 transition duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-lg hover:shadow-white/10"
					>
						Обсудить задачу
					</a>
					<a
						href="#services"
						class="inline-flex items-center rounded-lg border border-neutral-800 px-5 py-3 font-medium text-neutral-300 transition duration-200 hover:-translate-y-0.5 hover:border-neutral-600 hover:text-white"
					>
						Услуги и цены
					</a>
				</div>
			</div>
		</header>

		<!-- УСЛУГИ -->
		<section id="services" class="border-t border-neutral-900">
			<div class="mx-auto max-w-3xl px-6 py-20">
				<h2 class="reveal text-2xl font-semibold sm:text-3xl">Услуги и цены</h2>
				<p class="reveal reveal-delay-1 mt-3 text-neutral-400">
					Цены — за типовую задачу. Точную назову после короткого разговора: часто
					выходит дешевле, чем кажется.
				</p>

				<div class="mt-10 grid gap-4 sm:grid-cols-3">
					{
						services.map((service, index) => (
							/*
								index — порядковый номер карточки (0, 1, 2).
								По нему вешаем разную задержку, чтобы карточки
								появлялись друг за другом, а не все разом.
							*/
							<div
								class={`reveal reveal-delay-${index + 1} group rounded-xl border p-6 transition duration-300 hover:-translate-y-1 ${
									service.featured
										? 'border-neutral-700 bg-neutral-900 hover:border-indigo-500/50'
										: 'border-neutral-900 bg-neutral-950 hover:border-neutral-700'
								}`}
							>
								<h3 class="font-medium">{service.title}</h3>

								{/* group-hover: цена меняет цвет при наведении на всю карточку, а не только на саму цену */}
								<p class="mt-2 text-2xl font-semibold transition-colors duration-300 group-hover:text-indigo-300">
									{service.price}
								</p>

								<p class="mt-3 text-sm leading-relaxed text-neutral-400">
									{service.description}
								</p>

								<ul class="mt-4 space-y-2">
									{service.features.map((feature) => (
										<li class="flex gap-2 text-sm text-neutral-400">
											<span class="text-neutral-600">—</span>
											<span>{feature}</span>
										</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- РАБОТЫ — наполним на Этапе 3 -->
		<section id="cases" class="border-t border-neutral-900">
			<div class="mx-auto max-w-3xl px-6 py-20">
				<h2 class="reveal text-2xl font-semibold sm:text-3xl">Работы</h2>
				<p class="reveal reveal-delay-1 mt-3 text-neutral-400">Скоро здесь будут кейсы.</p>
			</div>
		</section>

		<!-- КОНТАКТЫ — этот блок пишешь ты -->
		<section id="contacts" class="border-t border-neutral-900">
			<div class="mx-auto max-w-3xl px-6 py-20">
				<h2 class="reveal text-2xl font-semibold sm:text-3xl">Контакты</h2>
				<p class="reveal reveal-delay-1 mt-3 text-neutral-400">TODO: блок делает Леонид</p>
			</div>
		</section>

		<script>
			/*
				Появление блоков при прокрутке.

				IntersectionObserver — встроенный в браузер механизм: он следит
				за элементами и сообщает, когда те попадают в видимую область.
				Раньше для этого считали позицию прокрутки вручную на каждый пиксель —
				браузер от этого тормозил. Здесь всё считает сам движок.
			*/
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							// Показали один раз — дальше не следим, лишняя работа не нужна
							observer.unobserve(entry.target);
						}
					});
				},
				{
					// Срабатывает, когда блок показался на 15% — не в самый последний момент
					threshold: 0.15,
				}
			);

			// Находим все элементы с классом reveal и отдаём под наблюдение
			document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
		</script>
	</body>
</html>
