---
import '../styles/global.css';

// Данные отдельно от разметки: правишь цену здесь — меняется на сайте.
const services = [
	{
		title: 'Telegram-бот',
		price: 'от 15 000 ₽',
		description: 'Меню, приём заявок, уведомления, рассылки. Подключение к вашим таблицам или CRM.',
		features: ['Сценарий и логика бота', 'Хостинг и запуск на сервере', '2 недели поддержки после сдачи'],
	},
	{
		title: 'Бот с оплатой',
		price: 'от 35 000 ₽',
		description: 'Подписки, приём платежей, база пользователей, админ-панель со статистикой.',
		features: ['Платежи и подписки', 'База данных и админка', 'Реферальная система'],
	},
	{
		title: 'Сайт-лендинг',
		price: 'от 20 000 ₽',
		description: 'Одностраничный сайт под задачу: услуги, товар, запись. Адаптив под телефон.',
		features: ['Вёрстка и адаптив', 'Форма заявок', 'Публикация и домен'],
	},
];
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Леонид — разработчик. Telegram-боты с оплатой, сайты, интеграции." />
		<title>Леонид — разработчик Telegram-ботов</title>
	</head>

	<body class="min-h-screen overflow-x-hidden bg-void font-sans text-bone-white antialiased">

		<!-- НАВИГАЦИЯ -->
		<nav class="relative z-20 mx-auto flex max-w-[1280px] items-center justify-between px-6 py-6">
			<span class="t-label text-bone-white">Леонид</span>

			<div class="flex items-center gap-6">
				<a href="#services" class="t-label hidden text-ash-gray transition-colors hover:text-bone-white sm:block">
					Услуги
				</a>
				<a href="#cases" class="t-label hidden text-ash-gray transition-colors hover:text-bone-white sm:block">
					Работы
				</a>
				<a
					href="https://t.me/yriveee"
					class="t-label rounded-full bg-electric-iris px-4 py-3 text-bone-white transition-opacity hover:opacity-90"
				>
					Написать
				</a>
			</div>
		</nav>

		<!--
			ПЕРВЫЙ ЭКРАН — центрированная композиция
			text-center + items-center + mx-auto — три места, где задаётся центровка:
			текст внутри блока, блоки внутри колонки, сама колонка на странице.
		-->
		<header class="relative flex min-h-[88vh] items-center overflow-hidden">

			<!-- Частицы: JS насыплет их сюда -->
			<div id="particles" class="pointer-events-none absolute inset-0"></div>

			<!--
				СФЕРА-КАПЛЯ
				Стоит за текстом по центру экрана.
				left-1/2 + -translate-x-1/2 — приём центрирования для absolute-блока:
				сдвигаем на половину ширины экрана, потом назад на половину своей ширины.
			-->
			<div class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
				<div class="blob h-[340px] w-[340px] opacity-70 sm:h-[520px] sm:w-[520px]"></div>
				<!-- Кольцо поверх — очерчивает сферу -->
				<div class="blob-ring absolute inset-0 m-auto h-[380px] w-[380px] sm:h-[580px] sm:w-[580px]"></div>
			</div>

			<!-- Контент поверх сферы -->
			<div class="relative z-10 mx-auto w-full max-w-[820px] px-6 py-[96px] text-center">
				<p class="rise t-label text-saffron-spark">
					Разработка на заказ
				</p>

				<h1 class="rise rise-delay-1 t-display mt-[30px]">
					Telegram-боты, которые приносят деньги
				</h1>

				<!-- mx-auto центрирует сам абзац, ограниченный по ширине -->
				<p class="rise rise-delay-2 t-body mx-auto mt-[36px] max-w-[520px] text-silver-mist">
					Меня зовут Леонид. Делаю ботов с приёмом оплаты, базой пользователей
					и админкой — от идеи до работающего сервера. Пишу код сам, серверы
					настраиваю сам.
				</p>

				<!-- justify-center — центрирует кнопки внутри flex-строки -->
				<div class="rise rise-delay-3 mt-[36px] flex flex-wrap items-center justify-center gap-[24px]">
					<a
						href="https://t.me/yriveee"
						class="t-label rounded-full bg-electric-iris px-[18px] py-[14px] text-bone-white transition-opacity hover:opacity-90"
					>
						Обсудить задачу
					</a>
					<a href="#services" class="t-label text-ash-gray transition-colors hover:text-bone-white">
						Услуги и цены →
					</a>
				</div>
			</div>
		</header>

		<!-- УСЛУГИ — тоже по центру -->
		<section id="services" class="mx-auto max-w-[1280px] px-6 py-[96px] text-center">
			<p class="reveal t-label text-saffron-spark">Услуги</p>
			<h2 class="reveal reveal-delay-1 t-heading mx-auto mt-[24px] max-w-[600px]">
				Цены и что входит
			</h2>
			<p class="reveal reveal-delay-2 t-body mx-auto mt-[24px] max-w-[520px] text-silver-mist">
				Цены — за типовую задачу. Точную назову после короткого разговора:
				часто выходит дешевле, чем кажется.
			</p>

			<div class="mx-auto mt-[60px] max-w-[900px]">
				{
					services.map((service, index) => (
						<div class={`reveal reveal-delay-${index + 1} border-t border-white/10 py-[36px]`}>
							<h3 class="t-heading-sm">{service.title}</h3>
							<p class="t-body mt-[12px] text-electric-iris">{service.price}</p>

							<p class="t-body mx-auto mt-[24px] max-w-[520px] text-silver-mist">
								{service.description}
							</p>

							{/* flex-wrap + justify-center — пункты идут в строку и центрируются */}
							<ul class="mt-[24px] flex flex-wrap justify-center gap-x-[24px] gap-y-[12px]">
								{service.features.map((feature) => (
									<li class="t-body flex gap-[12px] text-ash-gray">
										<span class="text-electric-iris">/</span>
										<span>{feature}</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<!-- РАБОТЫ — наполним на Этапе 3 -->
		<section id="cases" class="mx-auto max-w-[1280px] px-6 py-[96px] text-center">
			<p class="reveal t-label text-saffron-spark">Работы</p>
			<h2 class="reveal reveal-delay-1 t-heading mx-auto mt-[24px] max-w-[600px]">
				Что уже сделано
			</h2>
			<p class="reveal reveal-delay-2 t-body mx-auto mt-[24px] max-w-[520px] text-silver-mist">
				Скоро здесь будут кейсы.
			</p>
		</section>

		<!-- КОНТАКТЫ — этот блок пишешь ты -->
		<section id="contacts" class="mx-auto max-w-[1280px] px-6 py-[96px] text-center">
			<p class="reveal t-label text-saffron-spark">Контакты</p>
			<h2 class="reveal reveal-delay-1 t-heading mx-auto mt-[24px] max-w-[600px]">
				TODO: блок делает Леонид
			</h2>
		</section>

		<script>
			/* ---- Появление блоков при прокрутке ---- */
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.15 }
			);

			document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

			/* ---- Частицы вокруг сферы ---- */
			const field = document.getElementById('particles');
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (field) {
				const colors = ['#8052ff', '#ffb829', '#15846e', '#bdbdbd'];
				const count = reduceMotion ? 18 : 46;

				for (let i = 0; i < count; i++) {
					const dot = document.createElement('span');
					dot.className = 'particle';

					dot.style.left = `${Math.random() * 100}%`;
					dot.style.top = `${Math.random() * 100}%`;
					dot.style.background = colors[Math.floor(Math.random() * colors.length)];
					dot.style.opacity = `${0.25 + Math.random() * 0.5}`;

					dot.style.setProperty('--dx', `${(Math.random() - 0.5) * 120}px`);
					dot.style.setProperty('--dy', `${(Math.random() - 0.5) * 120}px`);

					dot.style.animationDuration = `${12 + Math.random() * 18}s`;
					dot.style.animationDelay = `${Math.random() * -20}s`;

					field.appendChild(dot);
				}
			}
		</script>
	</body>
</html>
