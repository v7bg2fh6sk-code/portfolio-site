---
import '../styles/global.css';

// Данные отдельно от разметки: правишь цену здесь — меняется на сайте.
const services = [
	{
		title: 'Telegram-бот',
		price: 'от 15 000 ₽',
		description: 'Меню, приём заявок, уведомления, рассылки. Подключение к вашим таблицам или CRM.',
		features: ['Сценарий и логика бота', 'Хостинг и запуск на сервере', '2 недели поддержки после сдачи'],
	},
	{
		title: 'Бот с оплатой',
		price: 'от 35 000 ₽',
		description: 'Подписки, приём платежей, база пользователей, админ-панель со статистикой.',
		features: ['Платежи и подписки', 'База данных и админка', 'Реферальная система'],
	},
	{
		title: 'Сайт-лендинг',
		price: 'от 20 000 ₽',
		description: 'Одностраничный сайт под задачу: услуги, товар, запись. Адаптив под телефон.',
		features: ['Вёрстка и адаптив', 'Форма заявок', 'Публикация и домен'],
	},
];
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Леонид — разработчик. Telegram-боты с оплатой, сайты, интеграции." />
		<title>Леонид — разработчик Telegram-ботов</title>
	</head>

	<!-- bg-void — чистый чёрный из токенов, не «тёмно-серый». В этом стиле пустота и есть дизайн. -->
	<body class="min-h-screen overflow-x-hidden bg-void font-sans text-bone-white antialiased">

		<!-- НАВИГАЦИЯ: прозрачная, без рамок и подложки -->
		<nav class="relative z-20 mx-auto flex max-w-[1280px] items-center justify-between px-6 py-6">
			<span class="t-label text-bone-white">Леонид</span>

			<div class="flex items-center gap-6">
				<!-- hidden sm:block — на телефоне ссылки прячем, оставляем только кнопку -->
				<a href="#services" class="t-label hidden text-ash-gray transition-colors hover:text-bone-white sm:block">
					Услуги
				</a>
				<a href="#cases" class="t-label hidden text-ash-gray transition-colors hover:text-bone-white sm:block">
					Работы
				</a>
				<!-- Единственная залитая кнопка на экране. Фиолетовый — только для действия. -->
				<a
					href="https://t.me/yriveee"
					class="t-label rounded-full bg-electric-iris px-4 py-3 text-bone-white transition-opacity hover:opacity-90"
				>
					Написать
				</a>
			</div>
		</nav>

		<!-- ПЕРВЫЙ ЭКРАН -->
		<header class="relative overflow-hidden">
			<!-- Сюда JS насыплет частицы -->
			<div id="particles" class="pointer-events-none absolute inset-0"></div>

			<div class="relative z-10 mx-auto max-w-[1280px] px-6 pb-[120px] pt-[60px] sm:pt-[96px]">
				<!-- Амбер-лейбл над заголовком — акцентный цвет референса -->
				<p class="rise t-label text-saffron-spark">
					Разработка на заказ
				</p>

				<!--
					Заголовок весом 400, не жирный. Иерархия здесь держится
					на размере и плотности букв, а не на толщине — это принцип стиля.
				-->
				<h1 class="rise rise-delay-1 t-display mt-[30px] max-w-[900px]">
					Telegram-боты, которые приносят деньги
				</h1>

				<p class="rise rise-delay-2 t-body mt-[36px] max-w-[520px] text-silver-mist">
					Меня зовут Леонид. Делаю ботов с приёмом оплаты, базой пользователей
					и админкой — от идеи до работающего сервера. Пишу код сам, серверы
					настраиваю сам.
				</p>

				<div class="rise rise-delay-3 mt-[36px] flex flex-wrap items-center gap-[24px]">
					<a
						href="https://t.me/yriveee"
						class="t-label rounded-full bg-electric-iris px-[18px] py-[14px] text-bone-white transition-opacity hover:opacity-90"
					>
						Обсудить задачу
					</a>
					<!-- Вторая ссылка — «призрачная», без фона. Залитая кнопка на экране только одна. -->
					<a href="#services" class="t-label text-ash-gray transition-colors hover:text-bone-white">
						Услуги и цены →
					</a>
				</div>
			</div>
		</header>

		<!--
			УСЛУГИ
			Без карточек: ни рамок, ни подложек, ни теней — только текст и воздух.
			Разделяют блоки тонкие линии, а не панели.
		-->
		<section id="services" class="mx-auto max-w-[1280px] px-6 py-[96px]">
			<p class="reveal t-label text-saffron-spark">Услуги</p>
			<h2 class="reveal reveal-delay-1 t-heading mt-[24px] max-w-[600px]">
				Цены и что входит
			</h2>
			<p class="reveal reveal-delay-2 t-body mt-[24px] max-w-[520px] text-silver-mist">
				Цены — за типовую задачу. Точную назову после короткого разговора:
				часто выходит дешевле, чем кажется.
			</p>

			<div class="mt-[60px]">
				{
					services.map((service, index) => (
						/*
							Каждая услуга — строка в две колонки: слева название и цена,
							справа описание. На телефоне колонки складываются в одну.
						*/
						<div
							class={`reveal reveal-delay-${index + 1} grid gap-[24px] border-t border-white/10 py-[36px] sm:grid-cols-[1fr_1.2fr]`}
						>
							<div>
								<h3 class="t-heading-sm">{service.title}</h3>
								<p class="t-body mt-[12px] text-electric-iris">{service.price}</p>
							</div>

							<div>
								<p class="t-body text-silver-mist">{service.description}</p>

								<ul class="mt-[24px] space-y-[12px]">
									{service.features.map((feature) => (
										<li class="t-body flex gap-[12px] text-ash-gray">
											<span class="text-electric-iris">/</span>
											<span>{feature}</span>
										</li>
									))}
								</ul>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- РАБОТЫ — наполним на Этапе 3 -->
		<section id="cases" class="mx-auto max-w-[1280px] px-6 py-[96px]">
			<p class="reveal t-label text-saffron-spark">Работы</p>
			<h2 class="reveal reveal-delay-1 t-heading mt-[24px] max-w-[600px]">
				Что уже сделано
			</h2>
			<p class="reveal reveal-delay-2 t-body mt-[24px] max-w-[520px] text-silver-mist">
				Скоро здесь будут кейсы.
			</p>
		</section>

		<!-- КОНТАКТЫ — этот блок пишешь ты -->
		<section id="contacts" class="mx-auto max-w-[1280px] px-6 py-[96px]">
			<p class="reveal t-label text-saffron-spark">Контакты</p>
			<h2 class="reveal reveal-delay-1 t-heading mt-[24px] max-w-[600px]">
				TODO: блок делает Леонид
			</h2>
		</section>

		<script>
			/* ---- Появление блоков при прокрутке ---- */
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target); // показали — дальше не следим
						}
					});
				},
				{ threshold: 0.15 }
			);

			document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

			/* ---- Частицы на первом экране ---- */
			const field = document.getElementById('particles');
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (field) {
				// Цвета берём из палитры референса, а не случайные
				const colors = ['#8052ff', '#ffb829', '#15846e', '#bdbdbd'];
				// При включённом «уменьшить движение» точек меньше и они не летают
				const count = reduceMotion ? 18 : 46;

				for (let i = 0; i < count; i++) {
					const dot = document.createElement('span');
					dot.className = 'particle';

					dot.style.left = `${Math.random() * 100}%`;
					dot.style.top = `${Math.random() * 100}%`;
					dot.style.background = colors[Math.floor(Math.random() * colors.length)];
					dot.style.opacity = `${0.25 + Math.random() * 0.5}`;

					// --dx / --dy читает @keyframes drift в global.css: куда дрейфует точка
					dot.style.setProperty('--dx', `${(Math.random() - 0.5) * 120}px`);
					dot.style.setProperty('--dy', `${(Math.random() - 0.5) * 120}px`);

					dot.style.animationDuration = `${12 + Math.random() * 18}s`;
					dot.style.animationDelay = `${Math.random() * -20}s`; // минус — чтобы стартовали вразнобой

					field.appendChild(dot);
				}
			}
		</script>
	</body>
</html>
